---
import PortalLayout from '../layouts/PortalLayout.astro';
import Hero from '../components/portal/Hero.astro';
import ModuleDeck from '../components/portal/ModuleDeck.astro';
import ProjectWire from '../components/portal/ProjectWire.astro';
import AliKitOverview from '../components/portal/AliKitOverview.astro';
import DispatchGrid from '../components/portal/DispatchGrid.astro';
import StatusRibbon from '../components/portal/StatusRibbon.astro';
import LowerIndex from '../components/portal/LowerIndex.astro';
import { site } from '../data/site';
---

<PortalLayout title="Alicorn — native GUI runtime for Odin" description={site.description}>
  <Hero />
  <ModuleDeck />
  <ProjectWire />
  <AliKitOverview />
  <DispatchGrid />
  <StatusRibbon />
  <LowerIndex />
</PortalLayout>
