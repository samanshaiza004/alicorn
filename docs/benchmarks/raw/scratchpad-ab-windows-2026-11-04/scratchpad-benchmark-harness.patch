+scratchpad_performance_sequence_schedule :: proc(app: ^App) {
+	if app == nil || !app.performance_sequence_enabled || app.performance_sequence_complete || app.performance_sequence_failed { return }
+	_ = host.application_schedule_after(app.services.scheduler, .Frequent, 150_000_000)
+}
+
+scratchpad_performance_sequence_fail :: proc(app: ^App, message: string) {
+	if app == nil { return }
+	app.performance_sequence_failed = true
+	fmt.eprintln("alicorn-performance-sequence failed", "step", app.performance_sequence_steps, message)
+}
+
+scratchpad_performance_sequence_open :: proc(app: ^App, rt: ^alicorn.Runtime, relative_path: string) -> bool {
+	if app == nil || rt == nil || !app.backend.state.has_workspace { return false }
+	path := fmt.tprintf("%s/%s", app.backend.state.workspace_root, relative_path)
+	response := bridge.backend_command(&app.backend, "open_path", path=path)
+	opened := response.ok
+	if opened {
+		handle_command_result(app, rt, &response)
+	} else {
+		fmt.eprintln("alicorn-performance-sequence open failed", relative_path, response.code, response.message)
+	}
+	bridge.backend_command_result_destroy(&response, context.allocator)
+	return opened
+}
+
+scratchpad_performance_sequence_step :: proc(app: ^App, rt: ^alicorn.Runtime) {
+	if app == nil || rt == nil || app.performance_sequence_complete || app.performance_sequence_failed { return }
+	if !app.smoke_rendered || !app.backend.state.has_workspace {
+		if !app.backend.state.has_workspace {
+			fmt.eprintln("alicorn-performance-sequence workspace state", "requested", app.workspace_path, "available", app.backend.state.has_workspace)
+		}
+		scratchpad_performance_sequence_schedule(app)
+		return
+	}
+	advanced := false
+	switch app.performance_sequence_steps {
+	case 0:
+		if scratchpad_performance_sequence_open(app, rt, "README.md") { advanced = true }
+	case 1:
+		if scratchpad_performance_sequence_open(app, rt, "application/sample_00.go") { advanced = true }
+	case 2:
+		for document in app.backend.state.documents {
+			if strings.has_suffix(document.path, "README.md") {
+				select_document(app, rt, document.id)
+				active, found := find_document(&app.backend.state, app.backend.state.active)
+				advanced = found && strings.has_suffix(active.path, "README.md")
+				break
+			}
+		}
+	case 3:
+		quick_open_open_surface(app, rt)
+		advanced = app.quick_open_open
+	case 4:
+		if app.quick_open_open && !app.quick_open_ready {
+			scratchpad_performance_sequence_schedule(app)
+			return
+		}
+		if app.quick_open_open { quick_open_close_surface(app, rt, true) }
+		advanced = !app.quick_open_open
+	case 5:
+		dispatch_action(app, rt, ACTION_WORKSPACE_SETTINGS)
+		advanced = app.settings_surface_open
+	case 6:
+		settings_surface_close(app, rt)
+		advanced = !app.settings_surface_open
+	case 7, 8:
+		if len(app.backend.state.documents) == 0 {
+			scratchpad_performance_sequence_fail(app, "expected both fixture documents to remain open")
+			return
+		}
+		expected_document_count := 1 if app.performance_sequence_steps == 8 else 2
+		dispatch_action(app, rt, ACTION_DOCUMENT_CLOSE)
+		advanced = len(app.backend.state.documents) < expected_document_count
+	case:
+		app.performance_sequence_complete = app.performance_sequence_steps == 9
+		return
+	}
+	if !advanced {
+		scratchpad_performance_sequence_fail(app, "action did not reach its expected state")
+		return
+	}
+	app.performance_sequence_steps += 1
+	app.performance_sequence_complete = app.performance_sequence_steps == 9
+	if !app.performance_sequence_complete { scratchpad_performance_sequence_schedule(app) }
+}
